# ==============================================================
# PINITHUB FORENSICS — Environment Configuration Example
# --------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. NEVER hard-code secrets.
# ==============================================================

# ---- Node Environment ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL via Supabase) ----
# Connection pooler URL (used by the app at runtime)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pinithub_forensics
# Direct connection (used by Prisma migrate / CLI)
DIRECT_URL=postgresql://postgres:password@localhost:5432/pinithub_forensics

# ---- Supabase ----
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# SERVICE ROLE KEY — server side ONLY. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ---- Supabase Storage Buckets ----
SUPABASE_STORAGE_BUCKET_ORIGINALS=originals
SUPABASE_STORAGE_BUCKET_ARTIFACTS=artifacts
SUPABASE_STORAGE_BUCKET_DATASETS=datasets
SUPABASE_STORAGE_BUCKET_MODELS=models

# ---- Python Forensic Service ----
FORENSICS_SERVICE_URL=http://localhost:8001

# ---- Upload Limits ----
# Maximum upload size in megabytes (for UX configuration)
MAX_UPLOAD_MB=25
# Maximum upload size in bytes (authoritative server-side limit)
MAX_IMAGE_UPLOAD_BYTES=26214400

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Logging ----
LOG_LEVEL=info
